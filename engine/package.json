    "calibrate": "tsx src/calibrate.ts",
    "tagebuch": "tsx src/tagebuch.ts",
    "mutate": "tsx src/mutate.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts"
}
