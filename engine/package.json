{
  "name": "loadwise-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rule engine for Loadwise. Pure functions over diary time series. No framework, no database, no UI.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx src/demo.ts",
    "typecheck": "tsc --noEmit",
