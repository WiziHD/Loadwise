{
  "name": "loadwise-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && npm run check:prerender",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:boundary": "tsx scripts/check-wording-boundary.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:dictionary": "tsx scripts/check-dictionary.ts",
    "check:prerender": "tsx scripts/check-no-prerendered-private.ts",
    "check:rls": "tsx scripts/check-rls.mts",
    "check:signin": "tsx scripts/check-signin.mts",
    "check:migrations": "tsx scripts/check-migrations.mts",
    "test": "tsx scripts/run-tests.ts",
    "test:roh": "vitest run",
    "check:ui-mutation": "tsx scripts/check-ui-mutation.ts",
    "check:service-role": "tsx scripts/check-service-role.ts",
    "check:verdicts": "tsx scripts/check-verdicts.mts",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "check:delete-account": "tsx scripts/check-delete-account.mts",
    "check:language": "tsx scripts/check-language.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "loadwise-engine": "*",
    "next": "^16.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
