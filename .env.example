# Loadwise — Umgebungsvariablen
#
# Kopieren nach `web/.env.local` und ausfüllen. `.env.local` steht in
# .gitignore und darf dort niemals herauskommen.

# Supabase-Projekt → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# ---------------------------------------------------------------------------
# NUR SERVERSEITIG. Niemals in eine Datei mit "use client", niemals mit
# NEXT_PUBLIC_ präfigieren, niemals in ein Repository.
#
# Dieser Schlüssel umgeht Row Level Security VOLLSTÄNDIG. Er ist die eine
# Zugangsberechtigung, die jedes Tagebuch jedes Nutzers lesen kann.
#
# Er existiert für genau eine Aufgabe: `flags` und `evaluations` schreiben.
# Nutzerkonten dürfen das nicht, damit ein manipulierter Client sich nicht
# selbst ein »alles in Ordnung« eintragen kann.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=<service role key>
